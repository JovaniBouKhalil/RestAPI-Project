{
  "name": "assignment6-notes-api",
  "version": "1.0.0",
  "private": true,
  "description": "A persistent notes REST API for Assignment 6.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db": "node scripts/local-db.js",
    "test": "node --test --test-concurrency=1",
