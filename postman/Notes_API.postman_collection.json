    {
      "name": "03 - Create a note and save noteId",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes"
          ]
        },
        "description": "03 - Create a note and save noteId",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Assignment 6 REST notes\",\n  \"body\": \"Review Express and MongoDB.\",\n  \"tags\": [\n    \"study\",\n    \"api\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"JSON response\", function () { if (!pm.response.headers.get(\"Content-Type\").includes(\"application/json\")) throw new Error(\"Expected JSON\"); });",
              "pm.test(\"Server-generated identity and timestamps\", function () { const note = pm.response.json(); if (!/^[a-f0-9]{24}$/.test(note._id) || !note.createdAt || !note.updatedAt) throw new Error(\"Missing metadata\"); pm.collectionVariables.set(\"noteId\", note._id); });",
              "pm.test(\"Created resource location\", function () { if (pm.response.headers.get(\"Location\") !== \"/api/notes/\" + pm.collectionVariables.get(\"noteId\")) throw new Error(\"Wrong Location\"); });"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "201 Created",
          "status": "Created",
          "code": 201,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"_id\": \"66f1c2e4b7a1d3f0c8e2a9b1\",\n  \"title\": \"Assignment 6 REST notes\",\n  \"body\": \"Review Express and MongoDB.\",\n  \"tags\": [\n    \"study\",\n    \"api\"\n  ],\n  \"createdAt\": \"2026-11-09T17:00:00.000Z\",\n  \"updatedAt\": \"2026-11-09T17:00:00.000Z\"\n}"
        }
